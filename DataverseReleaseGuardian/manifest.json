{
  "manifest_version": 3,
  "name": "Dynamics Release Guardian",
  "version": "0.1.0",
  "description": "Developer Tools for Dataverse & Dynamics 365",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.dynamics.com/*",
    "https://*.crm.dynamics.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dynamics.com/*",
        "https://*.crm.dynamics.com/*"
      ],
      "js": [
        "release-diff.js",
        "content.js",
        "release-diff-content.js"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Dynamics Release Guardian"
  }
}
